FROM python:3.11-slim

WORKDIR /app

# README.md is the package readme (pyproject); the build fails without it
COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY taxonomy/ ./taxonomy/

RUN pip install . --no-cache-dir

EXPOSE 8000

CMD ["uvicorn", "deep_xpia.server:app", "--host", "0.0.0.0", "--port", "8000"]
